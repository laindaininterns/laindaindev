PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

JWT_SECRET=your-jwt-secret

# --- Existing (Laila text chat) — do not touch ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
CHATBOT_MAX_TOKENS=400
CHATBOT_RATE_LIMIT_PER_MIN=20

# --- New: Rahi's own model/key (separate quota) ---
GROQ_API_KEY_RAHI=gsk_your_rahi_groq_key_here
RAHI_MODEL=llama-3.3-70b-versatile
RAHI_MAX_TOKENS=250
RAHI_RATE_LIMIT_PER_MIN=15

# --- New: STT (shared by both voice surfaces) ---
GROQ_API_KEY_STT=gsk_your_stt_groq_key_here
STT_MODEL=whisper-large-v3-turbo
STT_MAX_AUDIO_SECONDS=20
STT_RATE_LIMIT_PER_MIN=20

# --- New: TTS fallback provider ---
TTS_PROVIDER=azure
TTS_API_KEY=your_tts_provider_key
TTS_VOICE_ID_EN=en-US-JennyNeural
TTS_VOICE_ID_UR=ur-PK-UzmaNeural
TTS_RATE_LIMIT_PER_MIN=20
TTS_MAX_CHARS=350
