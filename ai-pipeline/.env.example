# Copy this file to .env and fill in real values.
# Never commit the real .env file, it's gitignored at the repo root.
# Company account keys go here for local dev. In Railway they're set
# directly in the service's Variables tab (Settings > Variables), not in a file.

# Environment
ENVIRONMENT=development          # development or production
LOG_LEVEL=info

# Internal auth: shared secret between the Node monolith and this service.
# Generate one with: openssl rand -hex 32
SERVICE_API_KEY=changeme-generate-a-real-secret

# Translation, primary provider: Azure Translator, F0 free tier (2M chars/month).
# Find these in Azure Portal under the Translator resource, Keys and Endpoint.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Translation, fallback provider: self-hosted LibreTranslate (see docker-compose.yml).
LIBRETRANSLATE_URL=http://libretranslate:5000

# Cache and queue: self-hosted Redis (see docker-compose.yml).
REDIS_URL=redis://redis:6379/0
TRANSLATION_CACHE_TTL_SECONDS=2592000   # 30 days

# Speech to text: self-hosted faster-whisper, no external API involved.
WHISPER_MODEL_SIZE=small          # tiny, base, small, medium, or large-v3
WHISPER_DEVICE=cpu                # cpu or cuda
WHISPER_COMPUTE_TYPE=int8         # int8 keeps CPU inference fast and light
MAX_VOICE_NOTE_SECONDS=60

# Intent tier 2: single-shot LLM classification.
# Point this at a self-hosted Ollama instance, or a hosted free-tier provider.
INTENT_LLM_BASE_URL=http://ollama:11434/v1
INTENT_LLM_MODEL=qwen2.5:7b-instruct
INTENT_LLM_API_KEY=

# Intent tier 3: bounded agent, used only for compound requests.
AGENT_MAX_STEPS=4
AGENT_TIMEOUT_SECONDS=8

# Where the agent's tools (search_listings, contact_seller) call out to.
# Points at the mock_backend fixture service for local dev, since there
# is no real Node backend with these endpoints yet. Swap this to the
# real Node monolith's internal API URL once it exists, nothing else
# needs to change, see docs/api_contract.md.
BACKEND_BASE_URL=http://mock-backend:8001
